# Never put real credentials in this tracked file. Copy to .env (ignored).
APP_ENV=development
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=yirenyoulu-app
JWT_AUDIENCE=yirenyoulu-mobile
AI_PROVIDER=disabled
MAIL_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AMAP_API_KEY=
# Independent development database only; see docs/技术开发/03数据库/迁移与备份恢复.md.
POSTGRES_DB=yirenyoulu_dev
POSTGRES_USER=yirenyoulu_dev
POSTGRES_PASSWORD=

# Optional backend containers: use the db service hostname, not localhost.
CONTAINER_DATABASE_URL=

# Exact browser preview origins only; native clients do not need CORS.
CORS_ORIGINS=[]
